server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # La dirección del backend y el DNS llegan por variables de entorno:
    # en compose: el nombre del servicio y el DNS de Docker
    # en Render: la URL de la api del entorno y un DNS público (8.8.8.8)
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on; # necesario porque la api de Render usa https
    }
}   